{
  "expo": {
    "scheme": "lunaguardapp",
    "name": "lunaguard",
    "slug": "lunaguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#301934"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyD56nBfBcvXRIOA76Rv5q3Lp84_M1LCF7Y"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#301934"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.lunaguard",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD56nBfBcvXRIOA76Rv5q3Lp84_M1LCF7Y"
        }
      }
    },
    "web": {
      "favicon": "./src/assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-audio",
      ["expo-location",
      {
        "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for safety features."
      }]
    ]
  }
}
