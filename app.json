{
  "expo": {
    "scheme": "lunaguardapp",
    "name": "lunaguard",
    "slug": "lunaguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#301934"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyD56nBfBcvXRIOA76Rv5q3Lp84_M1LCF7Y"
      },
      "infoPlist": {
        "NSMotionUsageDescription": "LunaGuard uses motion sensors to detect potential danger situations.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "permissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "ACTIVITY_RECOGNITION",
        "BODY_SENSORS",
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK",
        "ACCESS_NETWORK_STATE",
        "SEND_SMS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#301934"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.lunaguard",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD56nBfBcvXRIOA76Rv5q3Lp84_M1LCF7Y"
        }
      }
    },
    "web": {
      "favicon": "./src/assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#652a9c"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LunaGuard to access your camera for emergency recording.",
          "microphonePermission": "Allow LunaGuard to access your microphone for emergency recording.",
          "recordAudioAndroid": true
        }
      ],
      ["expo-location",
      {
        "locationAlwaysAndWhenInUsePermission": "Allow LunaGuard to access your location for emergency alerts.",
        "locationAlwaysPermission": "Allow LunaGuard to access your location in the background for emergency alerts.",
        "locationWhenInUsePermission": "Allow LunaGuard to access your location for emergency alerts."
      }]
    ]
  }
}